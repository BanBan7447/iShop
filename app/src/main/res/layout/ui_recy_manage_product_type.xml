<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/all_item_m_ProductT"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="20dp"
    android:orientation="vertical"
    android:background="@drawable/fill_radius_16"
    android:backgroundTint="@color/Background_Bill">
    
    <ImageView
        android:id="@+id/Data_Image_ProductType"
        android:layout_width="wrap_content"
        android:layout_height="175dp"
        android:layout_marginBottom="8dp"
        android:src="@mipmap/img_background"
        android:scaleType="centerCrop"/>

    <ImageButton
        android:id="@+id/Dialog_Fix_ProductType"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/btn_white_fix"
        android:background="@color/transparent"
        android:layout_alignParentEnd="true"/>
    
    <TextView
        android:id="@+id/TT_Code_ProductType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/Mã"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_below="@+id/Data_Image_ProductType"/>

    <TextView
        android:id="@+id/Data_Code_ProductType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ipe2007"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_below="@+id/Data_Image_ProductType"
        android:layout_toEndOf="@+id/TT_Code_ProductType"/>

    <TextView
        android:id="@+id/TT_Name_ProductType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/t_n_lo_i"
        android:textSize="16sp"
        android:layout_below="@+id/TT_Code_ProductType"/>

    <TextView
        android:id="@+id/Data_Name_ProductType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/iphone5"
        android:textSize="16sp"
        android:layout_below="@+id/TT_Code_ProductType"
        android:layout_toEndOf="@+id/TT_Name_ProductType"
        android:ellipsize="end"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/TT_Quantity_ProductType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/s_l_ng"
        android:textSize="16sp"
        android:layout_below="@+id/TT_Name_ProductType"/>

    <TextView
        android:id="@+id/Data_Quantity_ProductType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_34"
        android:textSize="16sp"
        android:layout_below="@+id/TT_Name_ProductType"
        android:layout_toEndOf="@+id/TT_Quantity_ProductType"
        android:ellipsize="end"
        android:maxLines="1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/m_u"
        android:textSize="16sp"
        android:layout_below="@+id/TT_Name_ProductType"
        android:layout_toEndOf="@+id/Data_Quantity_ProductType"
        android:ellipsize="end"
        android:maxLines="1"/>

</RelativeLayout>