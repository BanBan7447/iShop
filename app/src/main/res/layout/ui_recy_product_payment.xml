<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20dp"
    android:layout_marginRight="20dp"
    android:layout_marginTop="15dp"
    android:background="@drawable/stroke_bottom">

    <ImageView
        android:id="@+id/Data_Image_ProductCart"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/iphone_15_pro_max"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="15dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/Data_Name_ProductCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/iphone_15_pro_max1"
            android:textSize="18sp"
            android:textColor="@color/Dark"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/Data_Name_ProductTypeCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/i_phone"
            android:textSize="16sp"
            android:textColor="@color/PaleWhite"
            android:textStyle="bold"
            android:layout_below="@id/Data_Name_ProductCart"/>

        <TextView
            android:id="@+id/Data_Price_ProductCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/_309_900_000"
            android:textSize="20sp"
            android:textColor="@color/Link"
            android:textStyle="bold"
            android:layout_below="@+id/Data_Name_ProductTypeCart"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/đ_1"
            android:textSize="20sp"
            android:textColor="@color/Link"
            android:textStyle="bold"
            android:layout_below="@+id/Data_Name_ProductTypeCart"
            android:layout_toEndOf="@+id/Data_Price_ProductCart"/>

        <TextView
            android:id="@+id/Data_Quantity_ProductCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="10dp"
            android:text="@string/_10"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/Dark"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>

    </RelativeLayout>

</LinearLayout>