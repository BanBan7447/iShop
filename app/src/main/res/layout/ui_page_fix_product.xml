<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Type_Manager.Page_Fix_Product"
    android:background="@color/Light">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:id="@+id/Title_Page">

        <ImageView
            android:id="@+id/Icon_Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/todoz"
            android:src="@drawable/icon_back"
            android:rotation="180"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ch_nh_s_a_s_n_ph_m"
            android:textColor="@color/Dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_toEndOf="@+id/Icon_Back"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"/>
    </RelativeLayout>

    <EditText
        android:id="@+id/EdtFix_Code_Product"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/Title_Page"
        android:text="@string/NhậpMã"
        android:paddingStart="14dp"
        android:textStyle="bold"
        android:textColor="@color/Dark"
        android:background="@drawable/stroke_raidus_16"/>

    <EditText
        android:id="@+id/EdtFix_Name_Product"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/EdtFix_Code_Product"
        android:text="@string/nhap_tene"
        android:paddingStart="14dp"
        android:textStyle="bold"
        android:textColor="@color/Dark"
        android:background="@drawable/stroke_raidus_16"/>

    <EditText
        android:id="@+id/EdtFix_Price_Product"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/EdtFix_Name_Product"
        android:text="@string/nhập_giá"
        android:paddingStart="14dp"
        android:textStyle="bold"
        android:textColor="@color/Dark"
        android:background="@drawable/stroke_raidus_16"/>

    <EditText
        android:id="@+id/EdtFix_Description_Product"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/EdtFix_Price_Product"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="11dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/stroke_raidus_16"
        android:paddingStart="14dp"
        android:text="@string/nh_p_m_t"
        android:textColor="@color/Dark"
        android:textStyle="bold" />

    <Button
        android:id="@+id/Btn_Fix_Product"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="40dp"
        android:text="@string/x_c_nh_n"
        android:textStyle="bold"
        android:textSize="20sp"
        android:background="@drawable/fill_radius_16"
        app:backgroundTint="@color/Dark"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>