<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Type_Manager.Page_Statistical_Purchase"
    android:orientation="vertical"
    android:background="@color/Light">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@color/Light">

        <ImageView
            android:id="@+id/Icon_Back1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_back"
            android:rotation="180"/>

        <TextView
            android:id="@+id/Title_Page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:text="@string/th_ng_k_mua_h_ng"
            android:textColor="@color/Dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:layout_centerVertical="true"/>
    </RelativeLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/t_ng_s_n_h_ng_dat"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/Dark"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp">

        <TextView
            android:id="@+id/Data_Total_Sell_Orders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_100_000_000_000b"
            android:textSize="24sp"
            android:textColor="@color/Link"
            android:textStyle="bold"
            android:layout_marginStart="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/n"
            android:textSize="24sp"
            android:textColor="@color/Link"
            android:textStyle="bold"/>
    </LinearLayout>


    <Button
        android:id="@+id/btnDatePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ch_n_th_i_gian_th_ng_kd"
        android:textColor="@color/Dark"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@drawable/fill_radius_16"
        app:backgroundTint="#E3E3E3"/>



    <EditText
        android:id="@+id/edt_Date"
        android:layout_marginStart="20dp"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:hint="@string/yyyy_mm_dd"
        android:textSize="18sp"
        android:layout_marginTop="-10dp"
        />
    <Button
        android:id="@+id/btnXem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:text="XEM"
        android:textColor="@color/Dark"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@drawable/fill_radius_16"
        app:backgroundTint="#E3E3E3"/>




    <TextView
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/so_n_h_ng_t"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/Dark"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/Data_Sell_Orders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/Link"
            android:textStyle="bold"
            android:layout_marginStart="20dp"/>

    </LinearLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/doanh_thu_t_s_n_h_ng"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/Dark"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp">

        <TextView
            android:id="@+id/Data_Revenue_Orders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/Link"
            android:textStyle="bold"
            android:layout_marginStart="20dp"/>

    </LinearLayout>

</LinearLayout>