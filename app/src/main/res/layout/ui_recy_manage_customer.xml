<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="20dp"
    android:padding="10dp"
    android:background="@drawable/stroke_raidus_16"
    android:id="@+id/all_item_u"
    android:orientation="vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/Data_Image_Customer"
        android:layout_width="wrap_content"
        android:layout_height="135dp"
        android:src="@mipmap/avatar_khanh_vy"
        app:shapeAppearanceOverlay="@style/Custom_Shape"
        android:scaleType="centerCrop"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/m_sfs"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/Dark"/>

        <TextView
            android:id="@+id/Data_Code_Customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kh0000a"
            android:textSize="16sp"
            android:textColor="@color/Dark"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ah_t_n"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/Dark"/>

        <TextView
            android:id="@+id/Data_Name_Customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tr_n_kh_nh_vya"
            android:textSize="16sp"
            android:textColor="@color/Dark"
            android:ellipsize="end"
            android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sdta"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/Dark"/>

        <TextView
            android:id="@+id/Data_SDT_Customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0912214982fs"
            android:textSize="16sp"
            android:textColor="@color/Dark"
            android:ellipsize="end"
            android:maxLines="1"/>
    </LinearLayout>


</LinearLayout>