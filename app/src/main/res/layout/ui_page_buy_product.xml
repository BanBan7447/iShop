<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Type_Customers.Page_Detail_Product">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/Icon_Back_detail_product"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:rotation="180"
                android:src="@drawable/icon_back" />

            <ImageView
                android:id="@+id/Data_Image_Product"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:src="@mipmap/iphone_15_pro_max" />

            <TextView
                android:id="@+id/Data_Name_Product"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="40dp"
                android:text="iPhone 15 Pro Max"
                android:textColor="@color/Dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp">

                <TextView
                    android:id="@+id/Data_Price_Product"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30.990.000"
                    android:textColor="@color/Link"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/Currency_Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/Data_Price_Product"
                    android:text="@string/_Đ"
                    android:textColor="@color/Link"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/Btn_Down_Product"
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/Quantity_Product"
                    android:background="@color/Light"
                    android:src="@drawable/icon_down_product" />

                <TextView
                    android:id="@+id/Quantity_Product"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:layout_toStartOf="@+id/Btn_Up_Product"
                    android:text="@string/_1"
                    android:textColor="@color/Dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/Btn_Up_Product"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@color/Light"
                    android:src="@drawable/icon_up_product" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/m_t"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/Data_Description_Product"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="20dp"
                android:text="@string/iphone_15_pro_max_k_t_h_p_khung_th_p_kh_ng_g_v_m_t_l_ng_k_nh_m_sang_tr_ng_m_n_h_nh_oled_6_7_inch_tr_n_vi_n_c_ng_ngh_promotion_120hz_v_chip_a17_bionic_m_b_o_hi_u_n_ng_v_t_tr_i_h_th_ng_camera_ba_ng_k_nh_v_c_m_bi_n_lidar_mang_l_i_kh_n_ng_ch_p_nh_quay_video_xu_t_s_c_y_l_s_k_t_h_p_ho_n_h_o_gi_a_c_ng_ngh_v_ngh_thu_t"
                android:textSize="14sp" />

            <Button
                android:id="@+id/Btn_AddToCart"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="40dp"
                android:background="@drawable/fill_radius_16"
                android:text="@string/th_m_v_o_gi_h_ng"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@color/Link"/>
        </LinearLayout>
        </RelativeLayout>
</ScrollView>